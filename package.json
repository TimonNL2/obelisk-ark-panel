{
  "name": "obelisk-ark-panel",
  "version": "1.2.0",
  "description": "Obelisk: a simple, focused web panel for hosting ARK: Survival Ascended and ARK: Survival Evolved servers and clusters on Linux.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "cli": "node server/cli.js",
    "test": "node --test server/test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "compression": "^1.8.0",
    "croner": "^9.0.0",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/legacy-modes": "^6.4.2",
    "@codemirror/view": "^6.36.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@uiw/codemirror-theme-tokyo-night": "^4.23.7",
    "@uiw/react-codemirror": "^4.23.7",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "motion": "^12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.5"
  }
}
